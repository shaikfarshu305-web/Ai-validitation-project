# ============================================================
# PROOFRAQ — AI Response Verification System
# Environment Configuration
# ============================================================

# ── LLM Provider ─────────────────────────────────────────────
# Options: local | openai | gemini | anthropic
LLM_PROVIDER=local

# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (only needed if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude (only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# ── Database ──────────────────────────────────────────────────
# Default: SQLite (auto-created in backend/)
# For PostgreSQL: DATABASE_URL=postgresql://user:pass@localhost:5432/proofraq
DATABASE_URL=

# ── Vector Store ─────────────────────────────────────────────
VECTOR_DB_TYPE=faiss
CHUNK_SIZE=300
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.25

# ── Evaluation Tuning ─────────────────────────────────────────
HALLUCINATION_SENSITIVITY=standard
LLM_TEMPERATURE=0.2
